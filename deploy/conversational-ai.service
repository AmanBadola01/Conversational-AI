[Unit]
Description=Conversational AI website managed by PM2
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=slot20
Group=slot20
WorkingDirectory=/srv/agents/data/docs/Crew/conversational-ai-470215ac/code/Conversational-AI
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/srv/agents/data/docs/Crew/conversational-ai-470215ac/code/Conversational-AI/.runtime/pm2
# Operator must configure secure boot-time Vault injection for
# SECRET_GEMINI_API_KEY and SECRET_GROQ_API_KEY before enabling this unit.
ExecStart=/usr/local/bin/pm2-runtime start /srv/agents/data/docs/Crew/conversational-ai-470215ac/code/Conversational-AI/deploy/ecosystem.config.cjs
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
