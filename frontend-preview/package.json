{
  "name": "continuum-frontend-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.login.config.ts && python3 scripts/build-preview.py",
    "test": "node --import tsx scripts/input.test.tsx && node scripts/integration.test.mjs && node scripts/auth.test.mjs && node scripts/topology.test.mjs",
    "build:integrated": "npm run build && python3 scripts/build-integrated.py",
    "test:live": "node scripts/live-integration.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
